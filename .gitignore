# Generated recompiler output — derived from a copyrighted ROM. Never commit.
/src/gen/
/src/gen-*/
/recomp/funcs.h

# Imported from everscript-vscode but derived from the ROM (tools/import.mts): names for the generated C
/imported/

# The ROM itself, in every form. Players supply their own.
*.sfc
*.smc
*.srm

# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/
/out/

# Replays with a save state or save data hold memory from a ROM: local only. The movies in tools/compare/replays/ are
# input and settings only (tests/compare-units.test.mts checks each one).
/tools/compare/replays/local/
*.mmo
!/tools/compare/replays/*.mmo
*.mss

# Local probe output that names paths on one machine
/rom_probe.json

# Launcher/runtime state written beside the executable (and in the repo root
# when the game is run from there): the cached ROM path, keybinds, settings.
# All of it is one machine's, none of it is the project's.
/rom.cfg
/keybinds.ini
/config.ini
/input.ini

.DS_Store
