+_RESUME_FN = re.compile(r'^RecompReturn (\w+)\(CpuState \*cpu\) \{$')
+_RESUME_CASE = re.compile(r'/\* aot-resume \$([0-9A-F]{6}) m([01])x([01]) \*/$')
+
