+  s.vPos = 10; s.hPos = 0; s.beamMasterLast = 8000;          /* start & 7 = 0 */
+  assert(snes_next_refresh(&s, 8000) == 8538);
+  assert(snes_next_refresh(&s, 8538) == 8000 + 1364 + 538 - 4);
+  s.beamMasterLast = 8004;                                   /* start & 7 = 4 */
+  assert(snes_next_refresh(&s, 8004) == 8004 + 534);
+
+  puts("$4212 at the access: vblank and auto-joypad edges; refresh points PASS");
+  return 0;
+}
diff --git a/tests/dma/last_cycle_test.c b/tests/dma/last_cycle_test.c
new file mode 100644
index 00000000..1f1e6bd2
--- /dev/null
+++ b/tests/dma/last_cycle_test.c
@@ -0,0 +1,34 @@
+/* The last bus cycle of an instruction (snes/last_cycle.c), from code in WRAM:
+ * an internal operation 6 clocks, an access by its region's speed. */
+#define main hdma_harness_main
+#include "hdma_timing_test.c"
+#undef main
+#include <assert.h>
+#include "snes/last_cycle.h"
+
+Snes *g_snes;
+uint8_t g_memsel;
+
+static uint8_t s_ram[0x20000];
+
+static unsigned at(const uint8_t *code, unsigned n, uint32_t next) {
+  for (unsigned i = 0; i < n; i++) s_ram[0x1000 + i] = code[i];
+  return snes_last_cycle_clocks(0x7E1000, next);
+}
+
+int main(void) {
+  static Snes s;
+  s.ram = s_ram;
+  g_snes = &s;
+  g_cpu.DB = 0;
+  assert(at((const uint8_t[]){0xEA}, 1, 0x7E1001) == 6);                    /* NOP */
+  assert(at((const uint8_t[]){0xAD, 0x12, 0x42}, 3, 0x7E1003) == 6);       /* LDA $4212 */
+  assert(at((const uint8_t[]){0xAD, 0x16, 0x40}, 3, 0x7E1003) == 12);      /* LDA $4016 */
+  assert(at((const uint8_t[]){0xAD, 0x00, 0x10}, 3, 0x7E1003) == 8);       /* LDA $1000 */
+  assert(at((const uint8_t[]){0xD0, 0x10}, 2, 0x7E1002) == 8);             /* BNE, not taken */
+  assert(at((const uint8_t[]){0xD0, 0x10}, 2, 0x7E1012) == 6);             /* BNE, taken */
+  g_cpu.S = 0x1FF0;
+  assert(at((const uint8_t[]){0x48}, 1, 0x7E1001) == 8);                    /* PHA */
+  puts("last cycle: internal, I/O, joypad, WRAM, branches, stack PASS");
+  return 0;
+}
diff --git a/tests/dma/refresh_charge_test.c b/tests/dma/refresh_charge_test.c
new file mode 100644
index 00000000..a616a15f
--- /dev/null
+++ b/tests/dma/refresh_charge_test.c
@@ -0,0 +1,43 @@
+/* snes_refresh_charge (common_cpu_infra.c, cut out by
+ * tests/test_beam_events.py) with DRAM refresh at the beam
+ * (SNESRECOMP_REFRESH_AT_BEAM=1): one 40-clock stall per refresh point the
+ * CPU crossed, wherever the charge comes; argv[1] "off": 40 per 1364 clocks
+ * of CPU time, as before. */
+#define main hdma_harness_main
+#include "hdma_timing_test.c"
+#undef main
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+Snes *g_snes;
+void snes_refresh_charge(void);
+extern uint64_t g_refresh_charged_upto;
+
+static uint64_t run(uint64_t to) { g_cpu.master_cycles = to; snes_refresh_charge(); return g_cpu.master_cycles; }
+
+int main(int argc, char **argv) {
+  const bool on = !(argc > 1 && strcmp(argv[1], "off") == 0);
+  setenv("SNESRECOMP_REFRESH_AT_BEAM", on ? "1" : "0", 1);
+  static Snes s;
+  static Dma dma;
+  s.dma = &dma;
+  s.hdmaBeamOff = true;
+  g_snes = &s;
+  g_interp_apu_driving = 1;
+  s.vPos = 10; s.hPos = 0; s.beamMasterLast = 8000;   /* line start & 7 = 0: its point at H=538 */
+  assert(run(8000) == 8000 && g_refresh_charged_upto == 8000);
+  if (on) {
+    assert(run(8537) == 8537);                    /* short of the point: nothing */
+    assert(run(8538) == 8578);                    /* on it: the stall */
+    assert(run(8578 + 600) == 9178);              /* the next point is 9898 (H=534) */
+    assert(run(9898 + 10) == 9948);
+    assert(run(9948 + 2 * 1364) == 9948 + 2 * 1364 + 80); /* two points in one charge */
+    assert(run(50000000) == 50000000);            /* a teleport is not charged */
+  } else {
+    assert(run(8538) == 8538);
+    assert(run(8000 + 1364) == 8000 + 1364 + 40); /* per 1364 clocks of CPU time */
+  }
+  printf("refresh charge (%s) PASS\n", on ? "at the beam" : "per CPU time");
+  return 0;
+}
diff --git a/tests/dma/short_line_test.c b/tests/dma/short_line_test.c
new file mode 100644
index 00000000..9fd7b750
--- /dev/null
+++ b/tests/dma/short_line_test.c
@@ -0,0 +1,79 @@
+/* The short scanline: with SNESRECOMP_SHORT_LINE=1, line 240 of every other
+ * non-interlaced field lasts 1360 master clocks; with 0, every line 1364.
+ * argv[1]: "on" or "off". Real beam/register implementation; reuse the
+ * peripheral-only stubs of the HDMA harness. */
+#define main hdma_harness_main
+#include "hdma_timing_test.c"
+#undef main
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+static Ppu s_ppu;
+
+/* Walk to the next V=225 the way a frame driver does; returns the clocks. */
+static uint32_t to_vblank(Snes *s) {
+  uint32_t d = snes_master_clocks_until_line(s, 225);
+  if (!d) d = snes_master_clocks_until_line(s, 224) + 1364u; /* a whole field */
+  snes_sync_master_clock(s, s->beamMasterLast + d);
+  assert(s->vPos == 225 && s->hPos == 0);
+  return d;
+}
+
+int main(int argc, char **argv) {
+  const bool on = argc > 1 && strcmp(argv[1], "on") == 0;
+  setenv("SNESRECOMP_SHORT_LINE", on ? "1" : "0", 1);
+  Snes s = {0};
+  Dma dma = {0};
+  s.dma = &dma;
+  s.ppu = &s_ppu;
+  s.hdmaBeamOff = true;
+  g_interp_apu_driving = 1;
+
+  /* From reset: line 240 of the first field is long, then short and long by
+   * turns (MesenCE's V=225 edges from power-on). */
+  assert(to_vblank(&s) == 225u * 1364u && !s.fieldParity);
+  for (int field = 0; field < 6; field++) {
+    const uint32_t want = on && (field & 1) ? 357364u : 357368u;
+    assert(to_vblank(&s) == want);
+    assert(s.fieldParity == ((field & 1) == 0));
+  }
+
+  /* The short line itself: H wraps at 1360 on line 240 of a field with the
+   * parity set, the long line follows. */
+  s.vPos = 240; s.hPos = 1350; s.fieldParity = true; s.beamMasterLast = 0;
+  snes_sync_master_clock(&s, 12);
+  assert(on ? (s.vPos == 241 && s.hPos == 2) : (s.vPos == 240 && s.hPos == 1362));
+  s.vPos = 240; s.hPos = 1350; s.fieldParity = false; s.beamMasterLast = 0;
+  snes_sync_master_clock(&s, 12);
+  assert(s.vPos == 240 && s.hPos == 1362);
+
+  /* Clocks to a V IRQ and to a line across the short line. */
+  const uint32_t lost = on ? 4u : 0u;
+  s.vPos = 239; s.hPos = 100; s.fieldParity = true; s.beamMasterLast = 0;
+  s.vIrqEnabled = true; s.hIrqEnabled = false; s.vTimer = 242; s.inIrq = false;
+  assert(snes_master_clocks_until_irq(&s) == 3u * 1364u - 100u - lost);
+  assert(snes_master_clocks_until_line(&s, 242) == 3u * 1364u - 100u - lost);
+  uint64_t at = 0;
+  assert(snes_next_irq_master(&s, 1000, &at) && at == 1000u + 3u * 1364u - 100u - lost);
+  /* From past line 240 the next short line is a field later, of the other
+   * parity: none when this field's line was the short one. */
+  s.vPos = 241; s.hPos = 0; s.vTimer = 240;
+  assert(snes_master_clocks_until_irq(&s) == 261u * 1364u);
+  s.fieldParity = false;
+  assert(snes_master_clocks_until_irq(&s) == 261u * 1364u);
+  s.vPos = 239; s.vTimer = 241;
+  assert(snes_master_clocks_until_irq(&s) == 2u * 1364u);
+  s.vIrqEnabled = false;
+
+  /* Interlace keeps every line long. */
+  s_ppu.setini = 1;
+  s.vPos = 240; s.hPos = 1350; s.fieldParity = true; s.beamMasterLast = 0;
+  snes_sync_master_clock(&s, 12);
+  assert(s.vPos == 240 && s.hPos == 1362);
+  s_ppu.setini = 0;
+
+  printf("short line (%s): field lengths from reset, line 240 wrap, IRQ and line distances, interlace PASS\n",
+         on ? "on" : "off");
+  return 0;
+}
diff --git a/tests/frame_driver/exact_rules_test.c b/tests/frame_driver/exact_rules_test.c
new file mode 100644
index 00000000..9ff84aec
--- /dev/null
+++ b/tests/frame_driver/exact_rules_test.c
@@ -0,0 +1,107 @@
+/* The beam frame driver's exact rules (SNESRECOMP_BEAM_EXACT=1) against the
+ * real beam (snes.c), with a scripted CPU in place of the bridge: every
+ * instruction lasts 8 master clocks and its last cycle 8 (an 8-clock access).
+ * DRAM refresh is off here (SNESRECOMP_REFRESH_AT_BEAM=0, the charge is
+ * snesrecomp's runtime, not linked); the short line too, so a field is 357,368.
+ *
+ *  - the field's NMI follows the first instruction whose last cycle starts at
+ *    V=225 H=6 or later, and the interrupt sequence costs 60 clocks;
+ *  - an NMI enabled inside vblank, RDNMI still set, fires after the next
+ *    instruction, in that field. */
+#define main hdma_harness_main
+#include "../dma/hdma_timing_test.c"
+#undef main
+#include "../../runner/src/beam_frame_driver.c"
+#include <assert.h>
+#include <stdlib.h>
+
+Snes *g_snes;
+void (*g_interp_bridge_pc_hook)(uint32_t pc24, int m_flag, int x_flag);
+
+void cart_sync_coprocessors(Cart *cart, uint64_t master_clock) { (void)cart; (void)master_clock; }
+int cx4_irq_pending(const Cx4 *cx4) { (void)cx4; return 0; }
+bool sa1_cpu_irq_pending(const Sa1 *sa1) { (void)sa1; return false; }
+void cpu_write8(CpuState *cpu, uint8 bank, uint16 addr, uint8 v) { (void)cpu; (void)bank; (void)addr; (void)v; }
+bool ppu_checkOverscan(Ppu *ppu) { (void)ppu; return false; }
+void ppu_handleVblank(Ppu *ppu) { (void)ppu; }
+void ppu_runLine(Ppu *ppu, int line) { (void)ppu; (void)line; }
+void ppu_rasterBegin(Ppu *ppu) { (void)ppu; }
+void ppu_rasterRenderBegin(Ppu *ppu) { (void)ppu; }
+void ppu_rasterRenderEnd(Ppu *ppu) { (void)ppu; }
+int ppu_rasterTakeHdmaen(uint8_t *out) { (void)out; return 0; }
+void ppu_rasterApplyLine(Ppu *ppu, int line) { (void)ppu; (void)line; }
+void snes_refresh_charge(void) {}
+void snes_refresh_exempt(void) {}
+unsigned snes_last_cycle_clocks(uint32_t pc24, uint32_t next_pc24) { (void)pc24; (void)next_pc24; return 8; }
+
+/* The scripted CPU: main-line PCs count up from $808000; the NMI vector reads
+ * as 0 (cart_read), and its handler returns at once. */
+static uint64_t s_bridge_deadline, s_nmi_at, s_enable_from;
+static uint32_t s_pc = 0x808000;
+static int s_nmis;
+void interp_bridge_set_master_deadline(uint64_t master_clock) { s_bridge_deadline = master_clock; }
+int interp_bridge_run_until_quiescent(CpuState *cpu, uint32_t entry_pc24) {
+  if (entry_pc24 == 0) return 0; /* the NMI handler */
+  s_pc = entry_pc24;
+  while (!s_bridge_deadline || cpu->master_cycles < s_bridge_deadline) {
+    if (g_interp_bridge_pc_hook) g_interp_bridge_pc_hook(s_pc, 1, 1);
+    /* An instruction that enables NMI ($4200) from s_enable_from on. */
+    if (s_enable_from && cpu->master_cycles >= s_enable_from) { g_snes->nmiEnabled = true; s_enable_from = 0; }
+    cpu->master_cycles += 8;
+    s_pc++;
+    if (!s_bridge_deadline) break;
+  }
+  return 0;
+}
+int interp_bridge_run_interrupt(CpuState *cpu, uint32_t entry_pc24) { (void)cpu; (void)entry_pc24; return 0; }
+uint32_t interp_bridge_lle_resume_pc(void) { return s_pc; }
+int interp_bridge_lle_took_wai(void) { return 0; }
+
+static void on_nmi(void) { s_nmi_at = g_cpu.master_cycles; s_nmis++; }
+static const SnesBeamFrameHooks s_test_hooks = { .nmi_taken = on_nmi };
+
+int main(void) {
+  setenv("SNESRECOMP_BEAM_EXACT", "1", 1);
+  setenv("SNESRECOMP_REFRESH_AT_BEAM", "0", 1);
+  setenv("SNESRECOMP_SHORT_LINE", "0", 1);
+  static Snes snes;
+  static Dma dma;
+  static Ppu ppu;
+  snes.dma = &dma;
+  snes.ppu = &ppu;
+  g_snes = &snes;
+  g_ppu = &ppu;
+  g_interp_apu_driving = 1;
+  snes_beam_frame_driver_set_hooks(&s_test_hooks);
+  snes_beam_frame_driver_set_position(0x808000, false);
+
+  /* Field 1 from V=225 H=0 at clock 1,000,000, NMI on. */
+  const uint64_t f0 = 1000000;
+  snes.vPos = 225; snes.hPos = 0; snes.beamMasterLast = f0; g_cpu.master_cycles = f0;
+  snes.nmiEnabled = true;
+  snes_beam_frame_driver_run_frame();
+  assert(s_nmis == 1 && s_nmi_at == f0 + 60);
+  const uint64_t f1 = f0 + 357368;
+  /* The CPU ran past V=225 to the instruction NMI follows; the next field
+   * takes it there, 60 clocks later. Instructions start at f0 + 60 + 8k. */
+  snes_beam_frame_driver_run_frame();
+  assert(s_nmis == 2);
+  const uint64_t end = s_nmi_at - 60, last_start = end - 8;
+  assert(last_start >= f1 + 6 && last_start - 8 < f1 + 6);
+  assert((end - (f0 + 60)) % 8 == 0);
+
+  /* NMI off: enabled by an instruction 300 clocks into vblank, it fires after
+   * the next instruction, in that field. */
+  const uint64_t f2 = f1 + 357368, f3 = f2 + 357368;
+  snes_beam_frame_driver_run_frame();   /* field 2: NMI taken at its start, still on */
+  assert(s_nmis == 3);
+  snes.nmiEnabled = false;              /* the handler turned it off */
+  s_enable_from = f3 + 300;
+  snes_beam_frame_driver_run_frame();   /* field 3 starts at f3, NMI off: the late NMI in it */
+  assert(s_nmis == 4 && s_nmi_at > f3 + 300 && s_nmi_at < f3 + 300 + 8 + 8 + 60 + 8);
+  /* the enabling instruction, one more, then the sequence */
+  assert((s_nmi_at - 60) - (f3 + 300) <= 2 * 8);
+
+  puts("exact rules: NMI after the instruction with a cycle from H=6, 60-clock sequence, late NMI in its field PASS");
+  return 0;
+}
